# Copy to .env and fill in. .env is gitignored and never committed.
# Precedence at runtime: --api-key flag > ONYPHE_API_KEY env var > .env > config file.

ONYPHE_API_KEY=

# Optional — only if you have an Unrated API licence (basic auth on the
# unrated endpoint, key also echoed as the `k` query parameter).
# ONYPHE_UNRATED_EMAIL=
# ONYPHE_BASE_URL=https://www.onyphe.io/api
